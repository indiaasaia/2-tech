# ============================================================
#  PHASE 3 — COLD OUTREACH EMAIL SENDER (Berlin startups)
# ============================================================
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in GMAIL_APP_PASSWORD (16 chars, no spaces) + your facts.
# 3. Build the recipient list from Phase 2:
#       python3 build_email_list.py
#    Check the output:         python3 audit_personalization.py
# 4. Test with:  python3 send_emails.py --mode test --dry-run
#    Then:       python3 send_emails.py --mode test   (1 email to TEST_RECIPIENT)
#    Then real:  python3 send_emails.py --mode all --limit 5
# `.env` contains your password - it is git-ignored, never share it.
# ============================================================

# --- Sending account (this Gmail must have the App Password) ---
SENDER_EMAIL=ravalmeetkumar0@gmail.com
SENDER_NAME=Meetkumar Riteshkumar Raval

# Gmail App Password (16 characters, no spaces).
# Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_APP_PASSWORD=

# Replies go to this address (Reply-To + signature).
CONTACT_EMAIL=ravalmeett.de@gmail.com

# --- Test recipient (your own extra address - used only in test mode) ---
TEST_RECIPIENT=ravalmeett@gmail.com

# test = send ONE email to TEST_RECIPIENT only
# all  = send to the whole CSV list
SEND_MODE=test

# --- Files ---
# Recipient list, one row per (company, email) with personalization columns
# (contact_name, technical_focus, why_target, relevant_roles,
#  current_hiring_evidence, website). Generate it from Phase 2:
#       python3 build_email_list.py
CSV_PATH=contacts_to_send.csv

# Attachment (PDF or any file). Leave empty to send without one.
RESUME_PATH=

# --- Personal facts used inside the email (edit email_text.py to match) ---
DEGREE=M.Sc. Artificial Intelligence (in progress)
UNIVERSITY=BTU Cottbus-Senftenberg

# Structured skills, matched against each company's technical_focus (Layer 3).
# Format: "Skill: years, Skill, ..." (the ": years" part is optional).
SKILLS=Python: 3y, PyTorch: 1y, SQL, FastAPI, Docker

AVAILABILITY=immediately
GERMAN_LEVEL=B1
PHONE=+49 155 67018163

# --- Personalization (see PERSONALIZATION_PLAN.md) ---
# Roles you are open to, matched against each company's relevant_roles (Layer 4).
SENDER_ROLES=AI Engineering Working Student, Backend Working Student, Data Intern
# City used in "Based in ..." (replaces the hardcoded Berlin).
SENDER_LOCATION=Berlin
# Optional one-liner about your education (thesis / focus area).
EDUCATION_EXTRA=
# Optional profile links for the signature (Layer 6) - at most one is used
# per email, in order: LinkedIn, GitHub, portfolio.
LINKEDIN=
GITHUB=
PORTFOLIO=
# Optional per-company pre-written hooks (Layer 7): CSV with company_name,hook.
# Generate it from Phase 1 evidence with:  python3 generate_hooks.py
# Missing file = the Layer 2 hook (focus + why + hiring) is used instead.
EMAIL_HOOKS_CSV=data/email_hooks.csv

# --- Gemini (Layer 7 hook generation, see generate_hooks.py) ---
# Every key found is used, rotating on failure. Priority:
#   1. GEMINI_API_KEYS="key1,key2" (comma-separated)
#   2. GEMINI_API_KEY + GEMINI_API_KEY_2
#   3. Enabled Gemini keys in streamlit_app/settings.json (the app's key store)
# Leave empty here if you keep your two keys in streamlit_app/settings.json.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Primary model + fallback chain (tried in order on rate limits).
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash, gemini-3.5-flash

# --- Sending speed / safety (spam avoidance) ---
# Delay between emails (seconds) + random jitter on top.
DELAY_SECONDS=45
JITTER_SECONDS=15
# Max emails per company (from its CSV rows).
MAX_PER_COMPANY=3
# Max emails sent to any single domain per 24h to avoid clustering/spam flags.
MAX_PER_DOMAIN=2
# Send as plain text only (no HTML alternative): looks more personal and
# is less likely to be tabbed as Promotions by Gmail.
PLAIN_TEXT_ONLY=false
# Start LOW for a new account (20-30/day), raise only once mail stays in inbox.
MAX_PER_DAY=30
# Only dispatch live emails during German business hours (Mon-Thu 8:30-11:30, 13:30-16:30, Fri 8:30-12:00 CET).
CHECK_BUSINESS_HOURS=false

# Address parts to prefer sending first (comma-separated, lowercase).
LOCAL_KEYWORDS=

# --- Progress tracking ---
STATE_FILE=state.json
LOG_FILE=send_log.txt
HISTORY_FILE=sent_history.csv
